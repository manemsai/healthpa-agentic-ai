# HealthPA / Elevance AI configuration
# Copy this file to .env and adjust values for your environment.
# Application settings use the ELEVANCE_ prefix.

ELEVANCE_APP_NAME="Elevance AI"
ELEVANCE_ENVIRONMENT="local"
ELEVANCE_DEBUG="false"

# AWS / Bedrock settings used by experimental LLM components.
# Use your normal AWS credential chain; do not commit access keys.
ELEVANCE_AWS_REGION="us-east-1"
ELEVANCE_BEDROCK_MODEL_ID="amazon.nova-lite-v1:0"
ELEVANCE_EMBEDDING_MODEL_ID="amazon.titan-embed-text-v2:0"

# Default payer context
ELEVANCE_PAYER_NAME="Anthem"
ELEVANCE_PAYER_MARKET="IN"
ELEVANCE_LINE_OF_BUSINESS="COMMERCIAL"

# Optional policy source overrides
# ELEVANCE_ANTHEM_POLICY_INDEX_URL=""
# ELEVANCE_ANTHEM_POLICY_BASE_URL=""

# Local data/index paths
ELEVANCE_POLICY_INDEX_PATH="data/indexes/policies.faiss"
ELEVANCE_POLICY_METADATA_PATH="data/indexes/policies.parquet"
ELEVANCE_POLICY_RAW_OUTPUT_PATH="data/raw/anthem_policies.jsonl"
